/**
 * B2X 대표 인터뷰지 → 구글 설문지 생성 스크립트
 *
 * 사용법 (3분)
 * 1. https://script.google.com 접속 → [새 프로젝트]
 * 2. 기본 코드를 지우고 이 파일 내용을 전부 붙여넣기 → 저장
 * 3. 위쪽 함수 선택이 makeInterviewForm 인지 확인 → [실행]
 * 4. 처음 한 번 권한 허용 창이 뜨면 본인 계정으로 허용
 *    ("확인되지 않은 앱" 경고가 나오면 [고급] → [이동])
 * 5. 아래 [실행 로그]에 나온 링크 3개 확인
 *    - 응답 링크: 채원님께 보낼 링크
 *    - 편집 링크: 설문지 수정용 (우리만)
 *    - 응답 시트: 답변이 쌓이는 구글 시트
 */
function makeInterviewForm() {
  var TOPICS = [
    { label: 'FOUNDER', title: 'B2X는 어떤 회사인가요',
      why: '계정 첫인상 영상. "브랜드가 아니라 한국에 있는 당신의 공급자"를 30초 안에 보여줍니다.',
      qs: [
        ['B2X를 한 문장으로 소개한다면요?', '브랜드 회사와 무엇이 다른지 들어가면 좋아요.'],
        ['주로 함께 일하는 셀러는 어떤 분들인가요?', '나라, 판매 플랫폼(틱톡샵·아마존·인스타 등), 규모. 가장 작은 고객은 어느 정도인지도요.'],
        ['왓츠앱 클럽에 들어오면 매주 무엇을 받나요? 세 가지만 꼽아주세요.', '']
      ] },
    { label: 'MOQ', title: '최소 주문 수량',
      why: '셀러가 제일 먼저 막히는 벽. "1,000개가 아니라 10개부터"를 숫자로 보여줍니다.',
      qs: [
        ['해외 셀러가 한국 브랜드에 직접 연락하면 보통 최소 몇 개를 사라고 하나요?', '범위로 적어주세요. 가장 높았던 경우, 낮았던 경우도 있으면 좋아요.'],
        ['브랜드는 왜 그렇게 많이 사라고 하나요? 브랜드 입장에서 설명해주세요.', ''],
        ['B2X에서는 몇 개부터 살 수 있나요? 어떻게 가능한가요?', '공동구매가 실제로 돌아가는 방식, 주문이 다 안 모이면 어떻게 되는지까지요.'],
        ['실제 예를 하나 들어주세요.', '어떤 제품(종류만 적어도 돼요) · 혼자 사면 몇 개에 얼마 · 공동구매로 10개 사면 개당 얼마']
      ] },
    { label: 'SAMPLE', title: '샘플',
      why: '"큰 주문 전에 1개부터 확인한다"는 안심을 주는 영상입니다.',
      qs: [
        ['샘플은 어떤 조건으로 받을 수 있나요?', '몇 개까지 · 비용 · 배송비는 누가 · 받기까지 며칠 · 가능한 나라 · 나중에 주문하면 샘플비를 빼주는지'],
        ['샘플을 받으면 셀러가 꼭 확인해야 할 것 두세 가지는요?', '대표님이 실제로 확인하는 순서대로 적어주세요.'],
        ['(선택) 샘플 없이 바로 많이 샀다가 문제가 생긴 경우를 보셨나요?', '']
      ] },
    { label: '$500', title: '500달러로 시작한다면',
      why: '"뭘 사야 하지?"에 대한 대표님의 구체적인 답. 화면에는 창고에서 그 제품을 집는 장면이 들어갑니다.',
      qs: [
        ['대표님이라면 지금 500달러로 무엇을 몇 개씩 사시겠어요? 제품 세 개와 고른 이유를 적어주세요.', '제품명 · 개수 · 도매가 · 이유 한 줄. 촬영 날 이 세 제품을 손에 들고 말씀하시게 됩니다.'],
        ['처음 500달러로는 사지 말아야 할 것이 있다면요?', '']
      ] },
    { label: 'MISTAKES', title: '첫 수입 실수',
      why: '"이것만 피하면 된다" 3가지. 샘플 이야기는 앞에서 다루니 빼고 적어주세요.',
      qs: [
        ['처음 수입하는 셀러들이 가장 많이 하는 실수 세 가지와, 각각 어떻게 하면 되는지 적어주세요.', '예: 나라별 허가·등록 확인을 안 함, 배송 무게 계산을 안 함, 한 번에 종류를 너무 많이 삼…'],
        ['그중 가장 비싸게 치르는 실수의 실제 사례가 있나요?', '얼마를 손해 봤는지, 어떤 상황이었는지']
      ] },
    { label: 'FAKE', title: '가짜 공급처 구별법',
      why: '해외 셀러가 가장 무서워하는 것(사기·가품)을 한국 현지 공급자가 풀어주는 영상입니다.',
      qs: [
        ["해외 셀러가 '한국 공급처'에게 속는 경우는 주로 어떤 식인가요?", '가품, 돈만 받고 연락 끊김, 유통기한 임박 제품 등'],
        ['진짜 한국 공급처인지 셀러가 직접 확인하는 방법 두세 가지는요?', '가격이 너무 싸면 의심해야 하는 기준이 있다면 그것도요.'],
        ['B2X는 셀러가 믿을 수 있게 무엇을 보여줄 수 있나요?', '실제로 보여줄 수 있는 것만 적어주세요. 예: 사업자등록, 브랜드 거래 증빙, 창고 영상']
      ] },
    { label: 'NEVER', title: '절대 안 파는 제품',
      why: '"잘 팔려도 이건 안 떼온다"는 기준으로 전문가다운 모습과 신뢰를 동시에 보여줍니다.',
      qs: [
        ['잘 팔리는 걸 알지만 B2X에서는 다루지 않는 제품이나 카테고리가 있나요? 이유는요?', "특정 브랜드 이름 대신 '이런 유형'으로 적어주셔도 돼요."],
        ['(선택) 떼왔는데 생각보다 안 팔렸던 제품이 있나요? 거기서 배운 점은요?', '몇 개 떼왔고 어떻게 처리했는지. 좋은 이야기면 이 편을 이 내용으로 바꿀 수도 있어요.']
      ] },
    { label: 'STORY', title: '이 일을 시작한 이유',
      why: '해외 셀러가 "이 사람은 나 같은 사람을 안다"고 느끼게 하는 영상. 정보보다 장면이 중요해요.',
      qs: [
        ['무역 일은 언제, 어떻게 시작하셨나요? 떠오르는 장면 하나로 적어주세요.', '몇 년도, 몇 살, 어디서 뭘 하고 있었는지'],
        ['해외 셀러를 돕는 일은 왜 하게 되셨나요? 계기가 된 셀러나 사건이 있나요?', '실명은 빼고, 그 셀러가 지금 어떻게 지내는지도 있으면 좋아요.'],
        ['혼자 시작하려는 해외 셀러에게 한마디 한다면요?', '']
      ] },
    { label: '+', title: '더 하고 싶은 이야기',
      why: '위 질문에 없었지만 영상으로 꼭 말하고 싶은 것이 있으면 적어주세요.',
      qs: [
        ['(선택) 자유롭게 적어주세요.', '']
      ] }
  ];

  var form = FormApp.create('B2X 대표 인터뷰지 · 채원 대표님');
  form.setDescription(
    '현장 영상 8편을 대표님 인터뷰로 만듭니다. 여기 적어주신 답을 바탕으로 영상 대본을 짜고, ' +
    '촬영 날에는 그 대본을 대표님 말투로 말씀하시면 됩니다. 편한 말투로, 생각나는 만큼만 적어주세요.\n\n' +
    '적을 때 세 가지만 부탁드려요\n' +
    '1. 숫자는 대략이라도 꼭 적어주세요. (예: "많이" 대신 "보통 500~1,000개")\n' +
    '2. 실제 있었던 일을 하나씩 넣어주세요. 실명이나 업체 이름은 빼셔도 돼요.\n' +
    '3. 문장이 길어도 괜찮아요. 다듬는 건 저희가 합니다.\n\n' +
    '모든 칸은 선택이에요. 빈칸이 있어도 제출하시면 되고, 제출 후에도 링크로 다시 들어와 수정하실 수 있어요.'
  );
  form.setCollectEmail(false);
  form.setAllowResponseEdits(true);
  form.setProgressBar(true);
  form.setConfirmationMessage('감사합니다! 제출 후에도 "응답 수정" 링크로 언제든 고치실 수 있어요. 빈칸은 촬영 날 같이 채우면 됩니다.');

  TOPICS.forEach(function (t, i) {
    if (i > 0) {
      form.addPageBreakItem().setTitle(t.label + ' · ' + t.title).setHelpText(t.why);
    } else {
      form.addSectionHeaderItem().setTitle(t.label + ' · ' + t.title).setHelpText(t.why);
    }
    t.qs.forEach(function (q) {
      var item = form.addParagraphTextItem().setTitle(q[0]).setRequired(false);
      if (q[1]) item.setHelpText(q[1]);
    });
  });

  var ss = SpreadsheetApp.create('B2X 대표 인터뷰지 · 응답');
  form.setDestination(FormApp.DestinationType.SPREADSHEET, ss.getId());

  Logger.log('응답 링크 (채원님께 보낼 링크): ' + form.getPublishedUrl());
  Logger.log('편집 링크 (우리만): ' + form.getEditUrl());
  Logger.log('응답 시트: ' + ss.getUrl());
}
