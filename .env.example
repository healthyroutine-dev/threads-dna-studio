# ── Threads OAuth (없으면 목업 모드로 동작) ──────────────────
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=          # 예: https://<도메인>/api/auth/callback

# ── AI (없으면 목업 AI 응답) ─────────────────────────────────
ANTHROPIC_API_KEY=
AI_DAILY_LIMIT=30              # 유저별 일일 AI 호출 한도

# ── DB (없으면 로컬 .data/store.json 파일 저장소) ─────────────
DATABASE_URL=

# ── 세션 쿠키 서명 (없으면 개발용 기본값) ─────────────────────
SESSION_SECRET=
